{
  "// tailwind lives in the Next root": "frontend/, not the repo root",
  "tailwindCSS.experimental.configFile": "frontend/tailwind.config.ts",
  "prettier.ignorePath": ".prettierignore",

  "// hide generated output": "everything below is gitignored build or tooling output",
  "files.exclude": {
    "**/.idea": true,
    "**/.next": true,
    "**/.next-ci": true,
    "**/.next-pages": true,
    "**/coverage": true,
    "**/node_modules": true,
    "**/out": true,
    "**/playwright-report": true,
    "**/test-results": true,
    "**/tsconfig.tsbuildinfo": true
  }
}
