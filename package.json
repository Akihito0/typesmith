{
  "name": "typesmith",
  "version": "1.0.0",
  "private": true,
  "description": "Typography and UI design tooling — type scales, font pairing, WCAG contrast, and live mockups in one place.",
  "scripts": {
    "dev": "next dev frontend",
    "build": "next build frontend",
    "start": "next start frontend",
    "lint": "next lint frontend --dir app --dir docs --dir editor --dir landing --dir system --dir ui --dir e2e --dir ../backend",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.json",
    "test": "vitest run --config backend/vitest.config.ts",
    "test:watch": "vitest --config backend/vitest.config.ts",
    "test:coverage": "vitest run --config backend/vitest.config.ts --coverage",
    "test:e2e": "playwright test --config=frontend/playwright.config.ts --project=chromium",
    "test:e2e:ui": "playwright test --config=frontend/playwright.config.ts --project=chromium --ui",
    "test:visual": "playwright test --config=frontend/playwright.config.ts --project=visual",
    "format": "prettier --ignore-path .gitignore --ignore-path .prettierignore --write .",
    "format:check": "prettier --ignore-path .gitignore --ignore-path .prettierignore --check ."
  },
  "dependencies": {
    "geist": "1.3.1",
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "20.14.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "10.4.19",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.5",
    "postcss": "8.4.39",
    "prettier": "^3.9.5",
    "tailwindcss": "3.4.7",
    "typescript": "5.5.4",
    "vitest": "^4.1.10"
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "es5"
  }
}
