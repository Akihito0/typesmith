{
  "name": "typesmith",
  "version": "1.0.0",
  "private": true,
  "description": "Typography and UI design tooling — type scales, font pairing, WCAG contrast, and live mockups in one place.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config config/vitest.config.ts",
    "test:watch": "vitest --config config/vitest.config.ts",
    "test:e2e": "playwright test --config=config/playwright.config.ts --project=chromium",
    "test:e2e:ui": "playwright test --config=config/playwright.config.ts --project=chromium --ui",
    "test:visual": "playwright test --config=config/playwright.config.ts --project=visual",
    "format": "prettier --config config/.prettierrc.json --ignore-path .gitignore --ignore-path config/.prettierignore --write .",
    "format:check": "prettier --config config/.prettierrc.json --ignore-path .gitignore --ignore-path config/.prettierignore --check .",
    "test:coverage": "vitest run --config config/vitest.config.ts --coverage"
  },
  "dependencies": {
    "geist": "1.3.1",
    "next": "16.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "20.14.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "10.4.19",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.5",
    "postcss": "8.4.39",
    "prettier": "^3.9.5",
    "tailwindcss": "3.4.7",
    "typescript": "5.5.4",
    "vitest": "^4.1.10"
  }
}
